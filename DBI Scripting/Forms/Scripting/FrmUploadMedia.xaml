<Window x:Class="DBI_Scripting.Forms.Scripting.FrmUploadMedia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upload Media" Height="560" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <Style x:Key="SectionGroupBox" TargetType="GroupBox">
            <Setter Property="Margin" Value="10,6,10,0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0,4,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── File Selection ── -->
        <GroupBox Grid.Row="0" Header="File Selection" Style="{StaticResource SectionGroupBox}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- File Path -->
                <Label Grid.Row="0" Grid.Column="0" Content="Script Path :" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtScriptPath" Grid.Row="0" Grid.Column="1"
                         Style="{StaticResource FieldTextBox}" IsReadOnly="True" Background="#F5F5F5"/>
                <Button x:Name="btnBrowse" Grid.Row="0" Grid.Column="2"
                        Content="Browse" Height="26" Width="78" Margin="6,4,0,4"
                        Click="btnBrowse_Click"/>

                <!-- File Info -->
                <Label Grid.Row="1" Grid.Column="0" Content="File Info :" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="txtFileInfo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                           Margin="0,4" VerticalAlignment="Center"
                           Foreground="Gray" FontSize="11"
                           Text="No file selected"/>
            </Grid>
        </GroupBox>

        <!-- ── Upload Progress ── -->
        <GroupBox Grid.Row="2" Header="Upload Progress" Style="{StaticResource SectionGroupBox}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Progress bar -->
                <ProgressBar x:Name="progressBar" Grid.Row="0"
                             Height="22" Minimum="0" Maximum="100"
                             Margin="0,4,0,6"
                             Foreground="#2196F3"/>

                <!-- Status + Speed -->
                <Grid Grid.Row="1" Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtStatus" Grid.Column="0"
                               Text="Ready" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtSpeed" Grid.Column="1"
                               Text="" Foreground="SteelBlue" FontSize="11" VerticalAlignment="Center"/>
                </Grid>

                <!-- Transferred + Percent -->
                <Grid Grid.Row="2" Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtTransferred" Grid.Column="0"
                               Text="" Foreground="Gray" FontSize="11"/>
                    <TextBlock x:Name="txtPercent" Grid.Column="1"
                               Text="0%" FontWeight="Bold" Foreground="SteelBlue" FontSize="11"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ── Upload Log ── -->
        <GroupBox Grid.Row="3" Header="Upload Log" Style="{StaticResource SectionGroupBox}" Margin="10,6,10,0">
            <TextBox x:Name="txtLog"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     FontFamily="Consolas" FontSize="11"
                     Background="#1E1E1E" Foreground="#D4D4D4"
                     BorderThickness="0" Padding="6"/>
        </GroupBox>

        <!-- ── Buttons ── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,2">
            <Button x:Name="btnUpload" Content="Upload"
                    Style="{StaticResource ActionButton}"
                    Background="#2196F3" Foreground="White" FontWeight="SemiBold"
                    Click="btnUpload_Click"/>
            <Button x:Name="btnCancel" Content="Cancel"
                    Style="{StaticResource ActionButton}"
                    IsEnabled="False"
                    Click="btnCancel_Click"/>
            <Button x:Name="btnExit" Content="Exit"
                    Style="{StaticResource ActionButton}"
                    Click="btnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>
